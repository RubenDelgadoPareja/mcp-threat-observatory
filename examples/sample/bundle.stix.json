    {
      "type": "note",
      "spec_version": "2.1",
      "id": "note--d8803609-baab-5212-9484-03f9773e546e",
      "created": "2026-11-22T15:29:59.824Z",
      "modified": "2026-11-22T15:29:59.824Z",
