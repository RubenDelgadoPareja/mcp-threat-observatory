{
  "name": "mcp-threat-observatory",
  "version": "0.4.0",
  "description": "Passive, evidence-graded telemetry for the Model Context Protocol server ecosystem.",
  "license": "MIT",
  "author": "Ruben Delgado Pareja (https://github.com/RubenDelgadoPareja)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RubenDelgadoPareja/mcp-threat-observatory.git"
  },
  "homepage": "https://github.com/RubenDelgadoPareja/mcp-threat-observatory#readme",
  "bugs": {
    "url": "https://github.com/RubenDelgadoPareja/mcp-threat-observatory/issues"
  },
  "type": "module",
  "bin": {
    "mcpobs": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "runtime",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm run build",
    "site": "npm run build && node site/build.mjs"
  },
  "dependencies": {
    "commander": "^15.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^24.0.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "mcp",
    "threat-intelligence",
    "supply-chain",
    "security",
    "osint",
    "stix"
  ]
}
